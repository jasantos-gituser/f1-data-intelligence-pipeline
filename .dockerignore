# Virtual environment — container installs its own packages
.venv/

# Secrets — injected at runtime via environment variables on Render
.env
.env.*

# Data files — not part of the application
data/

# Documentation
docs/
README.md
CLAUDE.md
*.docx

# Claude tooling
.claude/
.claudeignore

# Tool config — linting and type checking not needed in container
pyproject.toml

# Git
.git/
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Tool caches
.mypy_cache/
.ruff_cache/

# Docker compose — used to orchestrate locally, not needed inside container
docker-compose.yml

# Tests — not run inside the production container
tests/
